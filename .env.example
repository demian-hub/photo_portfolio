# 실제 공개 도메인을 설정하면 해당 출처의 폼 요청만 허용됩니다.
# 로컬 실행에서는 비워두세요.
# SITE_URL=https://photos.example.com

# HTTPS 외부 공개 시 true로 설정합니다. 로컬 HTTP 확인은 false.
COOKIE_SECURE=false

# 기본값: 프로젝트/data/portfolio.sqlite
# DATABASE_PATH=D:/chatgpt/my-portfolio/data/portfolio.sqlite

# 문의 알림 수신: parkhanchul@gmail.com (서버 코드에서 고정)
# Gmail 발신 계정과 앱 비밀번호. 실제 값은 .env.local에만 저장하세요.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=parkhanchul@gmail.com
SMTP_PASS=
